{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DD2 cell request (overview Appendix A), frozen 2026-10-26",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "name", "inputs", "output", "expression", "truth_table", "sizing", "estimated_area_um2"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 32},
    "name": {"type": "string", "pattern": "^dd2_g[0-9]+__[a-z0-9_]+$"},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
               "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}},
    "output": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "expression": {"type": "string", "pattern": "^[A-Za-z0-9_!&|^() ]+$"},
    "truth_table": {"type": "string", "pattern": "^0x[0-9A-F]+$"},
    "sizing": {"enum": ["hd", "stack"]},
    "estimated_area_um2": {"type": "number", "exclusiveMinimum": 0}
  }
}

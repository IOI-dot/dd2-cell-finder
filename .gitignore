# Links created by `make setup`; the real inputs remain outside the repository.
pdk
given
tutorials
config/tools.mk
config/tools-install.json
*.vcd

# Build trees and local environments.
build/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Agent-runtime state may contain credentials or local conversation state.
.agents/

# Local secrets. Keep committed examples explicit rather than committing values.
.env
.env.*
!.env.example

# Private local material: never committed.
/DesignSystemStudio/
/Backend.md

# OS/editor noise.
.DS_Store
*.swp

# Never commit the PDK, supplied-file copies, build trees, or files over 50 MB.

# Course inputs and third-party material that must never be committed (overview 5.1).
DD2_Project1_student_pack/
# Course handouts and planning documents (course material and private plans; never committed):
#   DD2 Project 1 - Overview and Rules.pdf, Option 1 and Option 2 handouts,
#   DD2_Agentic_Standard_Cell_Studio_Implementation_Plan.pdf / .docx
*.pdf
*.docx
!report/*.pdf
references/
# Agent run outputs are evidence (Appendix B logs point into runs/); only bulky cut lists are skipped.
/runs/*/cuts_full/
/runs/*/work/

# Web app and browser-test output.
web/node_modules/
web/dist/
.playwright-mcp/
